# Vercel Postgres connection string (from Vercel dashboard -> Storage -> your DB -> .env.local tab)
POSTGRES_URL="postgres://user:password@host:5432/verceldb?sslmode=require"

# Secret used to sign session JWTs - generate with: openssl rand -base64 32
JWT_SECRET="change-me-to-a-random-32-byte-string"

# PINs used only once, by the seed script, to create the initial accounts.
# Pick your own 4-digit codes - these are not committed anywhere.
ADMIN_ERWIN_PIN="1111"
ADMIN_SHARON_PIN="2222"
CHILD_NOVA_PIN="3333"
CHILD_NOOR_PIN="4444"
CHILD_STIJN_PIN="5555"

# Shared PIN for the "Vrienden" (friends) login tile
FRIENDS_PIN="9999"
